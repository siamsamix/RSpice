* RSpice standard symbol library — the schematic editor's component picker.
*
* Format (see circuitsim/src/symbols.rs): one SYMBOL … ENDS block per part.
* Pins are in grid units, y grows down, the first pin is the origin, and the
* PIN ORDER is the SPICE card's node order. MODEL / SUBCKT name the card the
* part references, LIB the file that defines it (.include'd once per deck),
* SPICELINE the default extra card text. Drawings are authored facing right.

* ── Diodes ────────────────────────────────────────────────────────────────
SYMBOL diode D
  DESC Diode (anode, cathode)
  CATEGORY Diodes
  PIN A 0 0
  PIN K 3 0
  LINE 0 0 1 0
  LINE 1 -0.6 1 0.6
  LINE 1 -0.6 2 0
  LINE 1 0.6 2 0
  LINE 2 -0.6 2 0.6
  LINE 2 0 3 0
  MODEL D1N4148
  LIB standard.lib
ENDS

* ── MOSFETs ───────────────────────────────────────────────────────────────
SYMBOL nmos M
  DESC N-channel MOSFET (drain, gate, source, bulk)
  CATEGORY MOSFETs
  PIN D 0 0
  PIN G -2 2
  PIN S 0 4
  PIN B 2 2
  LINE 0 0 0 1
  LINE 0 1 1 1
  LINE 0 3 1 3
  LINE 0 3 0 4
  LINE 1 0.75 1 1.25
  LINE 1 1.75 1 2.25
  LINE 1 2.75 1 3.25
  LINE 0.5 0.75 0.5 3.25
  LINE -2 2 0.5 2
  LINE 1 2 2 2
  LINE 1.3 2 1.6 1.85
  LINE 1.3 2 1.6 2.15
  MODEL NMOS1
  LIB standard.lib
  SPICELINE W=10u L=1u
ENDS

SYMBOL pmos M
  DESC P-channel MOSFET (drain, gate, source, bulk)
  CATEGORY MOSFETs
  PIN D 0 0
  PIN G -2 2
  PIN S 0 4
  PIN B 2 2
  LINE 0 0 0 1
  LINE 0 1 1 1
  LINE 0 3 1 3
  LINE 0 3 0 4
  LINE 1 0.75 1 1.25
  LINE 1 1.75 1 2.25
  LINE 1 2.75 1 3.25
  LINE 0.5 0.75 0.5 3.25
  LINE -2 2 0.0 2
  CIRCLE 0.25 2 0.25
  LINE 1 2 2 2
  LINE 1.6 2 1.3 1.85
  LINE 1.6 2 1.3 2.15
  MODEL PMOS1
  LIB standard.lib
  SPICELINE W=20u L=1u
ENDS

* ── Bipolar transistors ───────────────────────────────────────────────────
SYMBOL npn Q
  DESC NPN bipolar transistor (collector, base, emitter)
  CATEGORY BJTs
  PIN C 0 0
  PIN B -2 2
  PIN E 0 4
  LINE 0 0 0 1
  LINE 0 1 0.5 1.5
  LINE 0.5 1 0.5 3
  LINE -2 2 0.5 2
  LINE 0.5 2.5 0 3
  LINE 0 3 0 4
  LINE 0.1 2.9 0.45 2.9
  LINE 0.1 2.9 0.1 2.55
  MODEL QNPN
  LIB standard.lib
ENDS

SYMBOL pnp Q
  DESC PNP bipolar transistor (collector, base, emitter)
  CATEGORY BJTs
  PIN C 0 0
  PIN B -2 2
  PIN E 0 4
  LINE 0 0 0 1
  LINE 0 1 0.5 1.5
  LINE 0.5 1 0.5 3
  LINE -2 2 0.5 2
  LINE 0.5 2.5 0 3
  LINE 0 3 0 4
  LINE 0.4 2.6 0.05 2.6
  LINE 0.4 2.6 0.4 2.95
  MODEL QPNP
  LIB standard.lib
ENDS

* ── Sources ───────────────────────────────────────────────────────────────
SYMBOL isource I
  DESC Independent current source (flows from + through the source to -)
  CATEGORY Sources
  PIN P 0 0
  PIN N 3 0
  LINE 0 0 0.75 0
  LINE 2.25 0 3 0
  CIRCLE 1.5 0 0.75
  LINE 0.9 0 2.1 0
  LINE 2.1 0 1.7 -0.3
  LINE 2.1 0 1.7 0.3
  SPICELINE DC 1m
ENDS

SYMBOL vcvs E
  DESC Voltage-controlled voltage source (out+, out-, ctrl+, ctrl-; gain in the SpiceLine)
  CATEGORY Sources
  PIN OP 0 0
  PIN ON 0 4
  PIN CP -3 1
  PIN CN -3 3
  LINE 0 0 0 1
  LINE 0 3 0 4
  RECT -1 1 1 3
  CIRCLE 0 2 0.4
  LINE -3 1 -1 1
  LINE -3 3 -1 3
  SPICELINE 1
ENDS

SYMBOL vccs G
  DESC Voltage-controlled current source (out+, out-, ctrl+, ctrl-; gm in the SpiceLine)
  CATEGORY Sources
  PIN OP 0 0
  PIN ON 0 4
  PIN CP -3 1
  PIN CN -3 3
  LINE 0 0 0 1
  LINE 0 3 0 4
  RECT -1 1 1 3
  LINE 0 1.5 0 2.5
  LINE 0 2.5 -0.25 2.15
  LINE 0 2.5 0.25 2.15
  LINE -3 1 -1 1
  LINE -3 3 -1 3
  SPICELINE 1m
ENDS

SYMBOL bsource B
  DESC Behavioral source (put V=<expr> or I=<expr> in the SpiceLine)
  CATEGORY Sources
  PIN P 0 0
  PIN N 3 0
  LINE 0 0 0.75 0
  LINE 2.25 0 3 0
  RECT 0.75 -0.5 2.25 0.5
  LINE 1.1 0.3 1.9 -0.3
  SPICELINE V=1
ENDS

* ── Switches ──────────────────────────────────────────────────────────────
SYMBOL switch S
  DESC Voltage-controlled switch (n+, n-, ctrl+, ctrl-)
  CATEGORY Switches
  PIN P 0 0
  PIN N 4 0
  PIN CP 0 2
  PIN CN 4 2
  LINE 0 0 1 0
  LINE 3 0 4 0
  LINE 1 0 2.8 -0.7
  RECT 0 1.5 4 2.5
  MODEL SW1
  LIB standard.lib
ENDS

* ── Subcircuits ───────────────────────────────────────────────────────────
SYMBOL opamp X
  DESC Op-amp macromodel subcircuit (in+, in-, out)
  CATEGORY Subcircuits
  PIN P 0 0
  PIN N 0 2
  PIN OUT 4 1
  LINE 0 -0.5 0 2.5
  LINE 0 -0.5 4 1
  LINE 0 2.5 4 1
  LINE 0.2 0 0.6 0
  LINE 0.4 -0.2 0.4 0.2
  LINE 0.2 2 0.6 2
  SUBCKT opamp
  LIB opamps.lib
ENDS

SYMBOL subckt2 X
  DESC Two-pin subcircuit instance (type the .subckt name in the properties)
  CATEGORY Subcircuits
  PIN A 0 0
  PIN B 4 0
  LINE 0 0 1 0
  LINE 3 0 4 0
  RECT 1 -1 3 1
ENDS
